@* @page "/game"
@using global::Blazor.Extensions.Canvas
@using global::Blazor.Extensions.Canvas.Canvas2D
@using Microsoft.JSInterop
@using DungeonSlayer.Client.Blazor.Services
@inject IJSRuntime JsRuntime
@inject ApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav

<div style="position:relative; width:100vw; height:100vh; background:#1a1a2e; overflow:hidden;">
    <canvas id="gameCanvas" @ref="canvasReference" style="display:block; width:100%; height:100%;"></canvas>
    <div id="moveZone" style="position:absolute; bottom:20px; left:20px; width:120px; height:120px; border-radius:50%; background:rgba(255,255,255,0.2); touch-action:none;"></div>
    <div id="aimZone" style="position:absolute; bottom:20px; right:20px; width:120px; height:120px; border-radius:50%; background:rgba(255,255,255,0.2); touch-action:none;"></div>
</div>

@if (showLevelComplete)
{
    <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:white; padding:20px; border-radius:8px; text-align:center; z-index:10;">
        <h3>Level Complete!</h3>
        <p>Kills: @lastKills</p>
        <p>XP Gained: @lastXp</p>
        <button @onclick="GoToProfile">Back to Profile</button>
    </div>
}

@code {
    private ElementReference canvasReference;
    private Canvas2DContext? context;
    private GameLoop? gameLoop;
    private bool showLevelComplete = false;
    private int lastKills;
    private int lastXp;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!AuthState.IsAuthenticated)
            {
                Nav.NavigateTo("/login");
                return;
            }

            // Создаём контекст из ссылки на элемент
            // context = await canvasReference.CreateCanvas2DAsync();

            // Используем IJSRuntime для создания контекста
            context = new Canvas2DContext(JsRuntime, canvasReference);
            // Инициализация контекста (если нужна)
            await context.InitializeAsync();


            gameLoop = new GameLoop(context, Api, OnLevelComplete, JsRuntime);
            gameLoop.Start();
        }
    }

    private void OnLevelComplete(int kills, int xp)
    {
        lastKills = kills;
        lastXp = xp;
        showLevelComplete = true;
        StateHasChanged();
    }

    private void GoToProfile()
    {
        Nav.NavigateTo("/profile");
    }

    public async ValueTask DisposeAsync()
    {
        if (gameLoop != null)
            await gameLoop.StopAsync();
    }
} *@

            @page "/game"
@using DungeonSlayer.Client.Blazor.Services
@inject AuthState AuthState
@inject NavigationManager Nav

<div style="text-align:center; padding:50px; color:white; background:#1a1a2e; min-height:100vh;">
    <h1>Game Page (Work in Progress)</h1>
    <p>Canvas initialization is temporarily disabled.</p>
    <button @onclick="GoToProfile" style="padding:10px 20px; font-size:16px; background:#4CAF50; color:white; border:none; border-radius:5px; cursor:pointer;">
        Go to Profile
    </button>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
        }
    }

    private void GoToProfile()
    {
        Nav.NavigateTo("/profile");
    }
}