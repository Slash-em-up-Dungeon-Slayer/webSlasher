# Скопируй этот файл в .env и заполни реальными значениями.
# .env добавлен в .gitignore и никогда не должен попасть в репозиторий.

POSTGRES_DB=dungeonrush
POSTGRES_USER=dr_user
POSTGRES_PASSWORD=change_me_use_a_strong_password

# Минимум 32 случайных символа. Генерировать, например:
#   openssl rand -base64 48
JWT_KEY=replace_with_a_long_random_secret_min_32_chars
JWT_ISSUER=DungeonRush.Api
JWT_AUDIENCE=DungeonRush.Client
JWT_ACCESS_TOKEN_MINUTES=15

# Домен(ы) фронтенда, которым разрешено обращаться к API (CORS)
ALLOWED_ORIGIN=http://localhost:8080
